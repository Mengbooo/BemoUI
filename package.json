		"delete:component": "node scripts/deleteComponent.js",
		"sync:component": "node scripts/syncComponent.js",
		"update:imports": "node scripts/updateImportPaths.js",
		"lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"import:codepen": "node scripts/importCodePen.js",
		"test:codepen-import": "node --test scripts/importCodePen.test.js",
		"import:magicui": "node scripts/importMagicUI.js",
		"import:magicui:all": "node scripts/importAllMagicUI.js",
		"test:magicui-import": "node --test scripts/importMagicUI.test.js scripts/importAllMagicUI.test.js",
		"sync:reactbits:components": "node scripts/syncReactBitsComponents.js --all",
		"test:reactbits-sync": "node --test scripts/syncReactBitsComponents.test.js",
		"test:component-routes": "node --test scripts/componentRoutes.test.js"
	},
